#include<bits/stdc++.h>
using namespace std;
int isPrime(int n)
{
    if(n < 2)
        return 0;
    for(int i=2; i<= sqrt(n); i++)
    {
        if(n%i == 0)
            return 0;
    }
    return 1;
}
//Or Using Sieve of eratosthenes-
void sieveofEratosthenes(int n)
{
    bool prime[n+1];
    memset(prime, true, sizeof(prime)); /// mark all element of prime as true
    prime[0] = prime[1] = false; /// since, 0 & 1 are not primes
    for(int i=2;  i*i <= n; ++i)
    {
        if(prime[i] == true)
        {
            for(int j=i*i; j<=n; j+=i)
            {
                prime[j] = false;
            }
        }
    }
    ///Printing Prime number
    for(int i=2; i<=n; ++i)
    {
        if(prime[i])
            cout << i << " ";
    }

}
int main()
{

   int n;
   cin>>n;
   cout<< "Output of prime function\n";
   for(int i=0; i<= n; i++)
   {
       if(isPrime(i))
        cout<< i<< " ";
   }
   cout<< "\nOutput of sieve function\n";
   sieveofEratosthenes(n);
}
